# napi build outputs. `binding.js` and `binding.d.ts` are generated by
# `napi build` from the Rust source, and the addon is a compiled artifact for
# one platform — none of the three belong in the tree.
*.node
packages/backend/binding.js
packages/backend/binding.d.ts
examples/*/bin/
examples/*/build/
